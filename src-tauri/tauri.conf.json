{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "青禾记账",
  "version": "1.1.0",
  "identifier": "com.qinghe.ledger",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "青禾记账",
        "width": 430,
        "height": 800,
        "minWidth": 430,
        "maxWidth": 430,
        "minHeight": 640,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
